# ==============================================================================
# Niyo Campus Student Ambassador Portal - Environment Configuration
# ==============================================================================

# Supabase Server-side Credentials (Edge Functions / Backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Client-side (Vite frontend) accessible variables (must be prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# NVIDIA NIM LLM Server-side Secrets (DO NOT prefix with VITE_)
# Get your API key from NVIDIA Build: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
